# Variables de entorno para Vercel Serverless Functions (api/contact.js)

# Requerido para envío real de emails (Resend.com)
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=

# Email de destino (opcional)
# Por defecto: juaneshm3@gmail.com
CONTACT_TO=

# Remitente verificado (opcional)
# Formato: "Portfolio <contact@tudominio.com>"
# Requiere dominio verificado en Resend. Por defecto: onboarding@resend.dev
CONTACT_FROM=

# Cloudflare Turnstile Secret Key (recomendado para protección anti-spam)
# Obtener en: https://dash.cloudflare.com/?to=/:account/turnstile
# Si se define, SE REQUIERE token válido del frontend
TURNSTILE_SECRET_KEY=
